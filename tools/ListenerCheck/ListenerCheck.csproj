<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the plugin's own HuntListener outside the game, to check the userscript end to end. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\plugin\HuntHop\HuntListener.cs" Link="Shared\HuntListener.cs" />
    <Compile Include="..\..\plugin\HuntHop\MobTable.cs" Link="Shared\MobTable.cs" />
  </ItemGroup>
</Project>
